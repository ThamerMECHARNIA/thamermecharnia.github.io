{% comment %}
  Render bibliography entries from site.bibliography without list markers or wrapper
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in site.bibliography %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ entry.title }}</a>
            </h6>
          {% else %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
          {% endif %}

          {% capture entrytype %}{% endcapture %}
          {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
          {% if entry.type == 'article' %}
            {% capture entrytype %}<em>{{ entry.journal }}</em>{% endcapture %}
          {% elsif proceedings contains entry.type %}
            {% capture entrytype %}<em>In {{ entry.booktitle }}</em>{% endcapture %}
          {% elsif entry.type == 'thesis' or entry.type == 'mastersthesis' or entry.type == 'phdthesis' %}
            {% capture entrytype %}<em>{{ entry.school }}</em>{% endcapture %}
          {% endif %}

          {% if entry.location %}
            {% capture entrytype %}{{ entrytype }}{{ ", " }}{{ entry.location }}{% endcapture %}
          {% endif %}

          {% if entrytype != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
              {{ entrytype | strip }}
            </h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
